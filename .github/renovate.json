{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "release:patch"
  ],
  "reviewers": [
    "arthurdw"
  ],
  "dependencyDashboard": false,
